# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN OMNINOVEL
# ==========================================

# 1. Hệ thống & Ports
PORT=8000
NODE_ENV=development
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000

# 2. Database (PostgreSQL)
# Local / CI: PostgreSQL Docker (port 5433)
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres_password_secure
DB_NAME=omninovel_db
DB_SSL=false
# Production (Supabase Managed PostgreSQL):
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# DB_SSL=true

# 3. Redis (Cache & Session & Queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 4. Object Storage (Provider-Neutral: MinIO Local vs Cloudflare R2 Production)
STORAGE_PROVIDER=minio
# --- Local MinIO Configuration (Fallback if STORAGE_PROVIDER=minio) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_MANGA=manga-media
MINIO_BUCKET_NOVEL=novel-media

# --- Standard S3 / Cloudflare R2 Configuration (Required in Production) ---
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
# S3_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
# S3_BUCKET_MANGA=omninovel-manga
# S3_BUCKET_NOVEL=omninovel-novel
# S3_FORCE_PATH_STYLE=false

# 5. Security & Authentication
JWT_SECRET=super_secret_jwt_key_omninovel_2026
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_2026
JWT_REFRESH_EXPIRATION=7d

# 6. AI Translation Service API Keys
AI_TRANSLATION_SERVICE_URL=http://localhost:8001
AI_WORKER_SECRET=internal_ai_worker_secret_secure_2026
OPENAI_API_KEY=your_openai_api_key_here
DEEPL_API_KEY=your_deepl_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
